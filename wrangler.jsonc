{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easy-offer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": false }
}
